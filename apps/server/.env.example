# ─────────────────────────────────────────────────────────────
# myClass server configuration – copy to apps/server/.env
# ─────────────────────────────────────────────────────────────

PORT=8787
# Public https:// address of this server in production (OAuth redirects, Secure cookies).
# Defaults to http://localhost:$PORT.
PUBLIC_URL=
# Where the web app runs (used for CORS + OAuth redirects).
# Defaults to http://localhost:5173 in development and to PUBLIC_URL in production.
WEB_ORIGIN=http://localhost:5173
# Folder for db.json and generated dev secrets. In production, use a persistent volume.
DATA_DIR=.data

# 32-byte base64 key used to encrypt stored eClass passwords (AES-256-GCM).
# Leave empty in development: a key is generated in DATA_DIR/secret.key.
# Set it explicitly in production and keep it stable across deploys.
ENCRYPTION_KEY=

# ── AI (Gemini) ──────────────────────────────────────────────
# Optional server-wide key ("myClass default" mode in Settings).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# "Connect Google account" (OAuth 2.0 web client from Google Cloud Console).
# Authorized redirect URI: ${PUBLIC_URL}/api/ai/google/callback (override below if needed)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/generative-language.retriever https://www.googleapis.com/auth/cloud-platform

# ── Web Push (generate with: npx web-push generate-vapid-keys) ─
# Leave empty in development: keys are generated in DATA_DIR/vapid.json
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Development helpers ──────────────────────────────────────
# Credentials used ONLY by `npm run probe` to snapshot real eClass pages
# into apps/server/fixtures/live (git-ignored). Never commit these.
PROBE_UNIVERSITY=unipi
PROBE_USERNAME=
PROBE_PASSWORD=
