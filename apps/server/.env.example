# ─────────────────────────────────────────────────────────────
# myClass server configuration – copy to apps/server/.env
# ─────────────────────────────────────────────────────────────

PORT=8787
# Public https:// address of this server in production (OAuth redirects, Secure cookies).
# Defaults to http://localhost:$PORT.
PUBLIC_URL=
# Where the web app runs (used for CORS + OAuth redirects).
# Defaults to http://localhost:5173 in development and to PUBLIC_URL in production.
WEB_ORIGIN=http://localhost:5173
# Folder for db.json and generated dev secrets. Not needed for users and sessions when
# Supabase is configured below; otherwise, in production, use a persistent volume.
DATA_DIR=.data

# ── Supabase (users and sessions in Postgres) ────────────────
# Leave both empty to use DATA_DIR/db.json (development and tests).
# Project Settings → API: the project URL and the service_role secret key. Server-side only:
# the service role key bypasses RLS, so never put it in the web app or commit it.
# Tables: supabase/migrations/*.sql. Copy existing data: npm run migrate:supabase -w @myclass/server
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 32-byte base64 key used to encrypt stored eClass passwords (AES-256-GCM).
# Leave empty in development: a key is generated in DATA_DIR/secret.key.
# Set it explicitly in production and keep it stable across deploys. With Supabase, it must be the
# key the stored data was encrypted with (the value in DATA_DIR/secret.key when migrating).
ENCRYPTION_KEY=

# ── AI (Gemini) ──────────────────────────────────────────────
# Shared key used by every student who has not added their own key in Settings.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional: force a model. Empty = pick the best available Flash / Flash-Lite model automatically.
GEMINI_MODEL=
# AI requests (chat messages, summaries, study sets) each student may make per hour on the
# shared key. Students who add their own key are not limited. 0 = no limit.
AI_HOURLY_LIMIT=15

# ── Web Push (generate with: npx web-push generate-vapid-keys) ─
# Leave empty in development: keys are generated in DATA_DIR/vapid.json
# In production set both (copy them from DATA_DIR/vapid.json when migrating), or saved
# push subscriptions stop working on every redeploy.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Development helpers ──────────────────────────────────────
# Credentials used ONLY by `npm run probe`, a live sign-in check against the real eClass.
# It runs only with PROBE_LIVE=1 and reads only pages eClass never counts as a visit.
# Never commit these.
PROBE_LIVE=
PROBE_USERNAME=
PROBE_PASSWORD=
